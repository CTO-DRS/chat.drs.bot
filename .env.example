# ─── chat.drs.bot environment configuration ────────────────────────────────

# Authentication secret (required)
# Generate one with: openssl rand -base64 32
# or visit https://generate-secret.vercel.app/32
AUTH_SECRET=

# SQLite database file path (required)
# The file is created automatically on first run (relative to project root)
DATABASE_PATH=db/drs-chat.db

# Optional: base path when serving the app under a sub-directory (e.g. /chat)
# NEXT_PUBLIC_BASE_PATH=

# Notes:
# - No AI gateway key needed: chat.drs.bot uses the built-in Z.AI provider
#   (lib/ai/zai-provider.ts) with streaming, tool calling and vision support.
# - No Postgres/Redis/Blob storage needed: everything is persisted in SQLite
#   via Drizzle ORM (better-sqlite3).
